# Maximum number of points sent to the frontend for visualization.
# Backend algorithms always run on the full-resolution cloud; this only
# controls what gets shipped to the browser to keep rendering smooth.
VIZ_MAX_POINTS=150000

# Max upload size in megabytes.
MAX_UPLOAD_MB=300

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
